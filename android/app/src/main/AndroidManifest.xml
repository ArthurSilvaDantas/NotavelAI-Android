<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Câmera: opcional no hardware; a permissão é pedida em tempo de execução -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Notificações: pedida em tempo de execução a partir do Android 13 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Requisição HTTP da cotação. O estado da rede é consultado antes da
         requisição, para não tentar acessar a internet sem conexão. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- allowBackup="false": o banco tem e-mails, hashes de senha e o histórico, e não deve
         sair do aparelho por backup. As regras em res/xml repetem isso para cada versão. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NotavelAI"
        tools:targetApi="31">

        <!-- Splash: única Activity de entrada. Mostra a tela de abertura do sistema enquanto
             consulta a sessão e encaminha para o Login ou para a tela principal. -->
        <activity
            android:name=".view.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.NotavelAI.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".view.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.CadastroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- FileProvider: gera o content:// Uri onde a câmera externa grava a foto -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
