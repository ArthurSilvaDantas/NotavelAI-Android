<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 ou anterior: nada do app vai para o backup. O banco guarda e-mails, hashes de
     senha e o histórico, e não deve sair do aparelho. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
